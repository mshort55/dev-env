# ============================================
# Directory Names
# ============================================
# These directory names are used on BOTH host and container
#
# IMPORTANT: If you change WORKSPACE_DIR_NAME, you MUST also update the "workspaceFolder" field in
# .devcontainer/dev/devcontainer.json to match "/${WORKSPACE_DIR_NAME}" to keep them in sync.
GENERAL_DIR_NAME=General
REPOS_DIR_NAME=Repos
WORKSPACE_DIR_NAME=UbuntuSync
BINARIES_DIR_NAME=Binaries

# ============================================
# Host Paths
# ============================================
# These paths point to directories on your host machine that will be mounted into the container.
# Adjust these to match your local directory structure.
HOST_GENERAL_DIR=${HOME}/${GENERAL_DIR_NAME}
HOST_REPOS_DIR=${HOME}/${REPOS_DIR_NAME}
HOST_WORKSPACE_DIR=${HOME}/${WORKSPACE_DIR_NAME}
HOST_BINARIES_DIR=${HOST_GENERAL_DIR}/${BINARIES_DIR_NAME}
HOST_DEV_ATUIN_CONFIG_DIR=${HOST_GENERAL_DIR}/.atuin_config
HOST_DEV_ATUIN_DATA_DIR=${HOST_GENERAL_DIR}/.atuin_data
HOST_DEV_CLAUDE_DIR=${HOST_GENERAL_DIR}/.claude_dev
HOST_DEV_CURSOR_DIR=${HOST_GENERAL_DIR}/.cursor
HOST_DEV_CODEX_DIR=${HOST_GENERAL_DIR}/.codex
HOST_DEV_ZELLIJ_CONFIG_DIR=${HOST_GENERAL_DIR}/.zellij_config
HOST_DEV_ZELLIJ_CACHE_DIR=${HOST_GENERAL_DIR}/.zellij_cache
# Podman socket inside the Podman VM (not the Mac-side forwarded socket).
# Container volumes resolve inside the VM, so this path must be the VM-internal socket.
# UID must match your Mac user's UID (run `id -u` on Mac to verify).
HOST_PODMAN_SOCK=/run/user/1000/podman/podman.sock

# ============================================
# Container User Configuration
# ============================================
# CONTAINER_USER: Username to create inside the container (use your preferred username)
# CONTAINER_UID: User ID to match your host user ID to avoid file permission issues on volume mounts
#   - macOS: Run `id -u` (typically 501)
#   - Linux: Run `id -u` (typically 1000)
CONTAINER_USER=yourname
CONTAINER_UID=1000

# ============================================
# Container Paths
# ============================================
# These paths are used inside the container.
# DEV_ENV_DIR: Location of this dev-env repository inside the container
DEV_ENV_DIR=/${REPOS_DIR_NAME}/dev-env

# KEEPASS_DB_PATH: Location of your KeePass database inside the container (OPTIONAL)
# If not set or file doesn't exist, secrets bootstrap will be skipped.
# Comment out or leave empty if you don't use KeePass for secrets management.
KEEPASS_DB_PATH=/${WORKSPACE_DIR_NAME}/Keepass/dev-env.kdbx

# ============================================
# Software Versions
# ============================================
ATUIN_VERSION=18.16.1
BUF_VERSION=1.70.0
GINKGO_VERSION=2.29.0
GO_VERSION=1.26.3
GRPCURL_VERSION=1.9.3
GOPLS_VERSION=0.22.0
HCP_VERSION=2.8.3-13
JQ_VERSION=1.8.2
KIND_VERSION=0.31.0
KUSTOMIZE_VERSION=5.8.1
NODE_VERSION=24.16.0
OPENSHIFT_VERSION=4.21.9
PODMAN_VERSION=5.8.2
RUST_VERSION=1.96.0
YQ_VERSION=4.53.2
ZELLIJ_VERSION=0.44.3

