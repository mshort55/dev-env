{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts", ".devcontainer/**/*.ts", ".agents/**/*.ts"],
  "exclude": ["**/archive", "**/node_modules", "verifications/evidence", "**/.venv", "**/.nox"]
}
