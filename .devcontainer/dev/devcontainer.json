{
  "dockerComposeFile": [
    "../../docker-compose.env-bridge.yml",
    "compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/UbuntuSync",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "version": "29.9.2-ubuntu24.04u2",
      "moby": true,
      "installDockerBuildx": false,
      "enableNonRootDocker": true,
      "mobyBuildxVersion": "0.38.1-ubuntu24.04u2",
      "dockerDashComposeVersion": "none"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "alefragnani.project-manager@13.1.0",
        "dbaeumer.vscode-eslint@3.0.34",
        "dinhani.copy-on-select@0.0.7",
        "eamodio.gitlens@19.4.0",
        "esbenp.prettier-vscode@12.4.0",
        "github.vscode-pull-request-github@0.172.0",
        "golang.go@0.58.0",
        "mikestead.dotenv@1.0.1",
        "ms-python.debugpy@2026.6.0",
        "ms-python.python@2026.10.0",
        "nrwl.angular-console@18.102.0",
        "redhat.vscode-yaml@2.0.0",
        "stylelint.vscode-stylelint@2.2.1",
        "timonwong.shellcheck@0.48.4",
        "tooltitudeteam.tooltitude-pb@1.31.2",
        "vscodevim.vim@1.32.4",
        "yoavbls.pretty-ts-errors@0.8.7",
        "ms-azuretools.vscode-containers@2.5.3",
        "ms-python.vscode-pylance@2026.4.1",
        "ms-python.vscode-python-envs@1.40.0"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "python.analysis.typeCheckingMode": "standard",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingParameterType": "error",
          "reportUnknownReturnType": "error",
          "reportUnknownVariableType": "warning"
        }
      }
    }
  },
  "postCreateCommand": "bash $DEV_ENV_DIR/.devcontainer/dev/post-create.sh"
}
