{
  "dockerComposeFile": [
    "../../docker-compose.env-bridge.yml",
    "compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/UbuntuSync",
  "customizations": {
    "vscode": {
      "extensions": [
        "alefragnani.project-manager@13.1.0",
        "dinhani.copy-on-select@0.0.7",
        "eamodio.gitlens@18.0.0",
        "github.vscode-pull-request-github@0.146.0",
        "golang.go@0.52.2",
        "ms-python.python@2026.4.0",
        "ms-python.debugpy@2026.6.0",
        "timonwong.shellcheck@0.39.5",
        "tooltitudeteam.tooltitude-pb@1.26.0",
        "vscodevim.vim@1.32.4"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "python.analysis.typeCheckingMode": "standard",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingParameterType": "error",
          "reportUnknownReturnType": "error",
          "reportUnknownVariableType": "warning" 
        }
      }
    }
  },
  "postCreateCommand": "bash $DEV_ENV_DIR/.devcontainer/dev/post-create.sh"
}