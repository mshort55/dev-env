{
  "dockerComposeFile": [
    "../../docker-compose.env-bridge.yml",
    "compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/UbuntuSync",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {
      "version": "29.8.1",
      "moby": true,
      "installDockerBuildx": true,
      "enableNonRootDocker": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "alefragnani.project-manager@13.1.1",
        "dbaeumer.vscode-eslint@3.0.34",
        "dinhani.copy-on-select@0.0.7",
        "eamodio.gitlens@19.2.0",
        "esbenp.prettier-vscode@12.4.0",
        "github.vscode-pull-request-github@0.166.1",
        "golang.go@0.56.1",
        "mikestead.dotenv@1.0.1",
        "ms-python.debugpy@2026.6.0",
        "ms-python.python@2026.4.0",
        "nrwl.angular-console@18.101.1",
        "redhat.vscode-yaml@1.24.0",
        "stylelint.vscode-stylelint@2.2.1",
        "timonwong.shellcheck@0.40.1",
        "tooltitudeteam.tooltitude-pb@1.29.4",
        "vscodevim.vim@1.32.4",
        "yoavbls.pretty-ts-errors@0.8.7"
      ],
      "settings": {
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": false,
        "python.analysis.typeCheckingMode": "standard",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingParameterType": "error",
          "reportUnknownReturnType": "error",
          "reportUnknownVariableType": "warning" 
        }
      }
    }
  },
  "postCreateCommand": "bash $DEV_ENV_DIR/.devcontainer/dev/post-create.sh"
}